rules_version = '2';

// These are the rules CURRENTLY DEPLOYED to the cleanerapp-3f196 project.
//
// Every caller must be authenticated. Four things talk to this database and
// all four sign in anonymously before their first call:
//   - the app            (firebase.ts ensureSignedIn, awaited in ProfileProvider)
//   - the Gmail scraper  (apps-script/Code.gs authHeaders)
//   - the Airbnb sync    (AirbnbSync/lib/firestore.js authHeaders)
//   - the website bridge (the site Worker's turnTrackIdToken)
// Changing anything here without changing all four locks something out.
//
// What this does and does not buy:
//   It closes the database to the open internet - reads used to need nothing
//   but the project id. It does NOT identify anyone: anonymous auth says
//   "some client of this project", and the web API key that mints those
//   tokens ships inside the app, so a determined person who extracts it can
//   still get in. Roles and PINs remain enforced in the app UI only.
//   The next real step up is Firebase App Check, which ties access to your
//   actual app binaries. Worth doing - this database holds door codes.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /jobs/{jobId} {
      allow read, write: if signedIn();
    }
    match /employees/{employeeId} {
      allow read, write: if signedIn();
    }
    match /timeEntries/{entryId} {
      allow read, write: if signedIn();
    }
    match /devices/{deviceId} {
      allow read, write: if signedIn();
    }
    match /pushTokens/{tokenId} {
      allow read, write: if signedIn();
    }
    // Includes settings/properties, which holds every house's door, garage and
    // supply code.
    match /settings/{settingId} {
      allow read, write: if signedIn();
    }

    // Anything not named above is closed, including collections added later:
    // a new collection has to be granted access here on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
