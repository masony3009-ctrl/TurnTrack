rules_version = '2';

// TurnTrack Firestore security rules.
//
// The app signs in anonymously on launch (see app/_layout.tsx), so every
// legitimate request carries request.auth. These rules reject anything that
// isn't authenticated, which closes the "anyone with the project ID can read
// or wipe the database" hole.
//
// NOTE: if your Google Apps Script ingestion writes to `jobs` via the REST
// API, it must now authenticate too (service-account OAuth token) or its
// writes will be denied. See SECURITY_SETUP.md.

service cloud.firestore {
  match /databases/{database}/documents {

    match /jobs/{jobId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.date is string
        && request.resource.data.address is string
        && request.resource.data.type is string;
    }

    match /pushTokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
